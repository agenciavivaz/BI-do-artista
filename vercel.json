{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "cd app && npm ci && npm run build",
  "outputDirectory": "app/dist",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/:slug", "destination": "/" },
    { "source": "/:slug/p/:id", "destination": "/" },
    { "source": "/:slug/simular/:sim?", "destination": "/" },
    { "source": "/:slug/:secao(perguntas|streaming|mapa|dados)", "destination": "/" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [ { "key": "X-Robots-Tag", "value": "noindex, nofollow" } ] }
  ]
}
